{
  "name": "code-breakdown",
  "displayName": "Code Breakdown",
  "description": "Continue learning while agentically coding. Breakdown code snippets into relevant concepts and store your learnings in a knowledge base.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeBreakdown.run",
        "title": "Code breakdown"
      },
      {
        "command": "codeBreakdown.setApiKey",
        "title": "Set API key",
        "category": "Code Breakdown"
      },
      {
        "command": "codeBreakdown.clearApiKey",
        "title": "Clear API key",
        "category": "Code Breakdown"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeBreakdown.run",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "~1.144.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
